APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Universal Converter ---
# Python 実行ファイル（仮想環境を使う場合は .venv/bin/python のフルパス）
CONVERTER_PYTHON=python3
# 1 回の変換のタイムアウト（秒）
CONVERTER_TIMEOUT=30
# アップロード上限（KB）
CONVERTER_MAX_UPLOAD_KB=2048
# 同時に実行できる変換の数（超えたリクエストは「混み合っています」と断る）
CONVERTER_MAX_CONCURRENT=2
# この分数より古い作業ディレクトリ（異常終了の残骸）を自動削除する
CONVERTER_CLEANUP_MINUTES=60
# 音声変換に使う FFmpeg / ffprobe（PATH にあれば指定不要。フルパスでも指定できる）
# CONVERTER_FFMPEG=ffmpeg
# CONVERTER_FFPROBE=ffprobe
# FFmpeg 1 回あたりのタイムアウト（秒）。Laravel 経由では CONVERTER_TIMEOUT - 5 が自動で渡される
# CONVERTER_FFMPEG_TIMEOUT=25

# プロキシの内側（Render など）で動かすときだけ設定する（例: *）
# TRUSTED_PROXIES=
